# Copy this file to .env locally and set real values. Never commit .env.
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=yourusername.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com
DJANGO_ADMIN_PATH=replace-with-a-random-private-path

# Optional Telegram integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
SITE_URL=https://xonsaroy.uz

# Optional email settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional social login credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
